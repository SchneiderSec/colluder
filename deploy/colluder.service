# Colluder dashboard: tails the engine's JSON lines, serves the UI on a private address.
# Its address, domain and paths come from ~/.config/colluder/config.yaml; optional secrets
# (DISCORD_WEBHOOK_URL) live in ~/.config/colluder/colluder.env (mode 600).
# A template: deploy/install.sh (run by ./colluder setup) fills in the @...@ values from config.yaml.
[Unit]
Description=Colluder dashboard (@DASH@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=@APP@
EnvironmentFile=-%h/.config/colluder/colluder.env
ExecStart=@NODE@ server.mjs
# a tailnet address may not exist yet at boot; keep retrying until it binds
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
