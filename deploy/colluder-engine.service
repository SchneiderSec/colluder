# Colluder engine: interactsh-client polling the payload domain and writing JSON lines.
# A template: deploy/install.sh (run by ./colluder setup) fills in the @...@ values from config.yaml.
# Server and token come from ~/.config/colluder/engine.yaml (mode 600) so the token is not on argv.
# Interactions arrive as JSON lines on stdout; systemd appends them to the log (the client's own -o
# truncates on every start). Logs and the banner go to stderr, i.e. the journal.
# SIGINT, not SIGTERM: the client saves its session file (and so keeps the correlation id and every
# planted payload valid across restarts) only from its interrupt handler.
[Unit]
Description=Colluder engine (interactsh-client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/mkdir -p @DATA@
ExecStart=@CLIENT_BIN@ -config %h/.config/colluder/engine.yaml \
  -sf @DATA@/session.yaml \
  -json \
  -ps -psf @DATA@/payload.txt \
  -v -duc -pi 2
StandardOutput=append:@DATA@/interactions.jsonl
StandardError=journal
KillSignal=SIGINT
TimeoutStopSec=10
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
