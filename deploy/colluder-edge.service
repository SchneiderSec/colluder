# Colluder edge: the public :80/:443 front door (PHASE2.md). System unit, runs as user with only
# the capability to bind low ports. Installed by deploy/cutover-phase2.sh.
[Unit]
Description=Colluder edge (public HTTP/HTTPS for oob.example, relays to interactsh)
After=network-online.target interactsh.service
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
UMask=0077
WorkingDirectory=/home/user/work/tools/oob-dashboard
# written by the cutover script: upstream addresses interactsh actually bound
EnvironmentFile=-/home/user/.config/colluder/edge.env
ExecStart=/home/user/.nvm/versions/node/v26.1.0/bin/node edge.mjs
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/user/.local/share/colluder
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
