# Colluder edge: the public front door. System unit, runs as the operator with only the
# capability to bind low ports. Its domain, address and certificate paths come from the operator's
# ~/.config/colluder/config.yaml. A template: deploy/edge.sh fills in the @...@ values.
[Unit]
Description=Colluder edge (public HTTP/HTTPS/DNS/SMTP, relays to interactsh)
After=network-online.target interactsh.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
UMask=0077
WorkingDirectory=@APP@
# written by the cutover script: upstream addresses interactsh actually bound
EnvironmentFile=-@HOME@/.config/colluder/edge.env
ExecStart=@NODE@ edge.mjs
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@DATA@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
